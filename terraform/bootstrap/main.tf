# Bootstrap module
# Runs once with the operator's personal GCP credentials before CI exists.
# Creates the CI identity (service account + Workload Identity Federation) and
# populates GitHub Actions secrets with non-sensitive config values.
#
# Sensitive values (SSH private key) are added to GitHub secrets manually by
# the operator — they are never passed through Terraform to keep them out of
# Terraform state entirely.
#
# Postgres passwords are generated by random_password in the main environment
# Terraform and stored directly in Secret Manager — they never need to be
# seen or entered by a human.

# Enable all GCP APIs required by the platform
resource "google_project_service" "apis" {
  for_each = toset([
    "compute.googleapis.com",
    "secretmanager.googleapis.com",
    "storage.googleapis.com",
    "iam.googleapis.com",
    "iamcredentials.googleapis.com",
    "cloudresourcemanager.googleapis.com",
  ])

  service = each.value

  # Disabling APIs on destroy would break the project — leave them enabled
  disable_on_destroy = false
}

# Dedicated service account for CI — scoped to only what Terraform needs
resource "google_service_account" "ci_deployer" {
  account_id   = "ci-deployer"
  display_name = "CI Deployer"
  depends_on   = [google_project_service.apis]
}

# Least-privilege IAM roles for the CI service account
# roles/editor is intentionally avoided — each role below is the minimum needed
locals {
  ci_sa_roles = [
    "roles/compute.admin",               # VMs, networks, firewall rules
    "roles/iam.serviceAccountAdmin",     # node service account management
    "roles/iam.workloadIdentityPoolAdmin", # WIF pool and provider management
    "roles/secretmanager.admin",         # Secret Manager secrets
    "roles/storage.admin",               # GCS buckets
    "roles/iam.securityAdmin",           # IAM policy bindings
    "roles/resourcemanager.projectIamAdmin", # project-level IAM bindings
  ]
}

resource "google_project_iam_member" "ci_roles" {
  for_each = toset(local.ci_sa_roles)
  project  = var.project_id
  role     = each.value
  member   = "serviceAccount:${google_service_account.ci_deployer.email}"
}

# Workload Identity Pool — GitHub Actions authenticates through this, no SA keys needed
resource "google_iam_workload_identity_pool" "github" {
  workload_identity_pool_id = "github-actions"
  display_name              = "GitHub Actions"
  depends_on                = [google_project_service.apis]
}

# OIDC provider — trusts tokens issued by GitHub Actions
resource "google_iam_workload_identity_pool_provider" "github" {
  workload_identity_pool_id          = google_iam_workload_identity_pool.github.workload_identity_pool_id
  workload_identity_pool_provider_id = "github-provider"
  display_name                       = "GitHub Provider"

  attribute_mapping = {
    "google.subject"       = "assertion.sub"
    "attribute.repository" = "assertion.repository"
  }

  attribute_condition = "assertion.repository == '${var.github_owner}/${var.github_repo}'"

  oidc {
    issuer_uri = "https://token.actions.githubusercontent.com"
  }
}

# Allow GitHub Actions in this specific repository to impersonate the CI SA
resource "google_service_account_iam_member" "wif_binding" {
  service_account_id = google_service_account.ci_deployer.name
  role               = "roles/iam.workloadIdentityUser"
  member             = "principalSet://iam.googleapis.com/${google_iam_workload_identity_pool.github.name}/attribute.repository/${var.github_owner}/${var.github_repo}"
}

# GitHub Actions secrets — non-sensitive config values only
# Sensitive values (SSH_PRIVATE_KEY) are added manually — see deployment guide

resource "github_actions_secret" "project_id" {
  repository      = var.github_repo
  secret_name     = "GCP_PROJECT_ID"
  plaintext_value = var.project_id
}

resource "github_actions_secret" "service_account" {
  repository      = var.github_repo
  secret_name     = "GCP_SERVICE_ACCOUNT"
  plaintext_value = google_service_account.ci_deployer.email
}

resource "github_actions_secret" "wif_provider" {
  repository      = var.github_repo
  secret_name     = "GCP_WORKLOAD_IDENTITY_PROVIDER"
  plaintext_value = google_iam_workload_identity_pool_provider.github.name
}

resource "github_actions_secret" "tf_state_bucket" {
  repository      = var.github_repo
  secret_name     = "TF_STATE_BUCKET"
  plaintext_value = var.tf_state_bucket
}

resource "github_actions_secret" "region" {
  repository      = var.github_repo
  secret_name     = "GCP_REGION"
  plaintext_value = var.region
}

resource "github_actions_secret" "admin_cidr" {
  repository      = var.github_repo
  secret_name     = "ADMIN_CIDR"
  plaintext_value = var.admin_cidr
}

resource "github_actions_secret" "subnet_cidr" {
  repository      = var.github_repo
  secret_name     = "SUBNET_CIDR"
  plaintext_value = var.subnet_cidr
}

# SSH public key is not sensitive — it is safe to store in GitHub secrets and Terraform state
resource "github_actions_secret" "ssh_public_key" {
  repository      = var.github_repo
  secret_name     = "SSH_PUBLIC_KEY"
  plaintext_value = var.ssh_public_key
}
