# Before running terraform init, create the GCS state bucket:
#   gcloud storage buckets create gs://<your-bucket-name> --location=europe-west1
#
# Then init with:
#   terraform init -backend-config="bucket=<your-bucket-name>"

project_id = "your-gcp-project-id"
region     = "europe-west1"
zone       = "europe-west1-b"
admin_cidr = "203.0.113.10/32"  # replace with your IP

# Generate with: cat ~/.ssh/id_rsa.pub
ssh_public_key = "ssh-rsa AAAA..."

# Postgres passwords are auto-generated by Terraform (random_password resource)
# and stored directly in Secret Manager. No passwords needed here.
