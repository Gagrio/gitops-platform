---
# ansible-lint configuration
# https://ansible-lint.readthedocs.io/configuring/

warn_list: []

skip_list:
  # Role variable naming convention (e.g., require 'flux_' prefix inside the flux role).
  # This is a style preference — we use descriptive names without role prefixes
  # because variables are passed as extra-vars from CI and shared across roles.
  - var-naming

  # Prefer get_url/uri module over curl. curl is used for binary downloads
  # (k3s installer, Flux CLI) where shell-level control and progress output
  # are needed and the module equivalents are less convenient.
  - command-instead-of-module

  # Shell tasks with pipes should set pipefail. The tasks that trigger this
  # are wrapped in conditional checks (creates:, when:) that make the pipe
  # failure mode irrelevant — but fixing them properly requires refactoring
  # each task. Tracked for future cleanup.
  - risky-shell-pipe

  # Tasks that run shell/command should declare changed_when. These tasks
  # check their own idempotency conditions (creates:, when: ... is not defined)
  # so the change tracking is handled externally.
  - no-changed-when

  # Blank lines between playbook plays / task blocks. Yamllint's empty-lines
  # rule flags the single blank line used as visual separators between plays,
  # which is standard YAML formatting in Ansible playbooks.
  - yaml[empty-lines]

